{
  "manifest_version": 2,
  "id": "maibot-team.maibot-helper",
  "version": "1.12.0",
  "name": "maibot_helper",
  "description": "为 Bot 提供 MaiBot 部署与 SDK 文档、版本更新、插件市场搜索、版本兼容性、统计排行榜及只读模型任务分配查询工具。",
  "author": {
    "name": "MaiBot开发团队",
    "url": "https://github.com/MaiM-with-u"
  },
  "license": "GPL-v3.0-or-later",
  "urls": {
    "repository": "https://github.com/MaiM-with-u/MaiBot",
    "homepage": "https://docs.maibot.chat/",
    "documentation": "https://docs.maibot.chat/plugin/",
    "issues": "https://github.com/MaiM-with-u/MaiBot/issues"
  },
  "host_application": {
    "min_version": "1.3.12",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.15.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "market.search",
    "market.get_detail",
    "market.get_readme"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "locales_path": "_locales",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
