{
  "schema_version": 2,
  "required_capabilities": [
    "custom_pages"
  ],
  "pages": [
    {
      "id": "group-mappings",
      "title": "QQ 官方适配器",
      "description": "",
      "icon": "list",
      "mode": "custom",
      "queries": {
        "mappings": {
          "api": "webui_mappings",
          "version": "1"
        },
        "avatar": {
          "api": "webui_mapping_avatar",
          "version": "1",
          "parameters": {
            "kind": {
              "type": "string",
              "required": true,
              "choices": [
                "group",
                "user"
              ]
            },
            "openid": {
              "type": "string",
              "required": true
            },
            "source": {
              "type": "string",
              "choices": [
                "manual",
                "auto",
                "union"
              ]
            },
            "group_openid": {
              "type": "string"
            }
          }
        },
        "login_status": {
          "api": "webui_login_status",
          "version": "1"
        },
        "mapping_migrations": {
          "api": "webui_mapping_migrations",
          "version": "1"
        },
        "identity_mode": {
          "api": "webui_identity_mode",
          "version": "1"
        }
      },
      "entry": "webui/mappings.html",
      "actions": {
        "login_start": {
          "api": "webui_login_start",
          "version": "1",
          "confirmation": "扫码授权成功后将替换当前机器人的 AppID / AppSecret 并自动启用连接，是否继续？"
        },
        "login_cancel": {
          "api": "webui_login_cancel",
          "version": "1"
        },
        "finish_mapping": {
          "api": "webui_finish_mapping",
          "version": "1",
          "confirmation": "关闭 QQ 号映射，后续使用原始 OpenID。是否继续？"
        },
        "set_mapping_mode": {
          "api": "webui_set_mapping_mode",
          "version": "1",
          "parameters": {
            "enabled": {
              "type": "boolean",
              "required": true
            }
          }
        },
        "delete_bindings": {
          "api": "webui_delete_bindings",
          "version": "1",
          "confirmation": "删除所选绑定及相关静默匹配记录？历史用户数据不受影响。",
          "parameters": {
            "kind": {
              "type": "string",
              "required": true,
              "choices": [
                "group",
                "user"
              ]
            },
            "openids_json": {
              "type": "string",
              "required": true
            }
          }
        }
      }
    }
  ]
}
