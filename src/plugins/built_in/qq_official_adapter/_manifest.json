{
  "manifest_version": 2,
  "id": "Mai-with-u.qq-adapter",
  "version": "0.4.7",
  "name": "QQ 官方机器人适配器",
  "description": "直连 QQ 开放平台官方 API，支持群聊与单聊的文本、@、图片、表情、语音收发及视频、文件发送，提供禁言、解除禁言、撤回工具。",
  "author": {
    "name": "MaiBot Team",
    "url": "https://github.com/Mai-with-u"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/Mai-with-u/MaiBot-QQ-Adapter"
  },
  "plugin_type": "adapter",
  "display": {
    "icon": {
      "type": "local",
      "value": "assets/icon.svg",
      "fallback": "plug",
      "background": "#E5EAEC"
    }
  },
  "host_application": {
    "min_version": "1.3.18",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.19.0",
    "max_version": "2.98.99"
  },
  "dependencies": [
    {"type": "python_package", "name": "pillow", "version_spec": ">=9"},
    {
      "type": "python_package",
      "name": "aiohttp",
      "version_spec": ">=3.14.3"
    },
    {
      "type": "python_package",
      "name": "qrcode",
      "version_spec": ">=8.2"
    },
    {
      "type": "python_package",
      "name": "cryptography",
      "version_spec": ">=50.0.0"
    },
    {
      "type": "python_package",
      "name": "tomlkit",
      "version_spec": ">=0.13.3"
    }
  ],
  "capabilities": [
    "api.call",
    "component.disable",
    "component.enable",
    "message.get_by_id"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
